{
  "schema_version": 1,
  "kind": "casa1-release-policy",
  "workflows": {
    ".github/workflows/ci.yml": {
      "aggregate_job": "ci-gate",
      "aggregate_name": "CI Gate",
      "required_jobs": [
        "fmt",
        "check",
        "clippy",
        "clippy-all-features",
        "test",
        "api-gate",
        "integration-tests",
        "docs",
        "fuzz-build",
        "fuzz-smoke",
        "warning-count",
        "policy-check",
        "ci-gate"
      ]
    },
    ".github/workflows/release.yml": {
      "aggregate_job": "release-gate",
      "aggregate_name": "Release Gate",
      "required_jobs": [
        "check-compile",
        "check-format",
        "check-clippy",
        "check-tests",
        "check-no-insecure-tls",
        "check-dependency-audit",
        "check-licenses",
        "check-reproducible",
        "signed-build",
        "steam-e2e",
        "release-smoke-tests",
        "audit-release-entitlements",
        "check-release-gate",
        "release-gate"
      ]
    },
    ".github/workflows/windows-oracle.yml": {
      "aggregate_job": "oracle-gate",
      "aggregate_name": "Windows Oracle",
      "required_jobs": [
        "generate-corpus",
        "reference-capture",
        "compare",
        "oracle-gate"
      ]
    }
  },
  "contract": {
    "ci_workflow": ".github/workflows/ci.yml",
    "release_workflow": ".github/workflows/release.yml",
    "nightly_workflow": ".github/workflows/nightly.yml",
    "api_gate_job": "api-gate",
    "api_gate_name_terms": [
      "Completeness",
      "Regression"
    ],
    "api_gate_commands": [
      "--gate completeness",
      "ci/check_api_regression.sh"
    ],
    "release_completeness_job": "check-release-gate",
    "release_completeness_commands": [
      "--gate completeness"
    ],
    "manifest_write_command": "ci/evidence_manifest.py --write ci/test-manifest.json",
    "manifest_verify_command": "ci/evidence_manifest.py",
    "manifest_path": "ci/test-manifest.json",
    "manifest_artifact_prefix": "test-manifest-",
    "manifest_fold_argument": "--test-manifest",
    "api_gate_forbidden_commands": [
      "api-report --gate none"
    ],
    "ubsan_script": "ci/run_nightly_ubsan_if_supported.sh",
    "ubsan_required_tokens": [
      "-Zsanitizer=undefined",
      "-Zbuild-std",
      "ci/meta-tests.txt",
      "--skip",
      "--lib --bins --tests"
    ],
    "forbid_feature_tokens": [
      "metal"
    ],
    "forbid_command_patterns": [
      "git push --force",
      "git push -f",
      "git push --force-with-lease",
      "git push --delete",
      "git branch -D",
      "git reset --hard",
      "--no-verify"
    ],
    "windows_oracle": {
      "workflow": ".github/workflows/windows-oracle.yml",
      "source": "windows_reference/src/win32.rs",
      "build_command": "cargo build --manifest-path windows_reference/Cargo.toml --release",
      "required_categories": [
        "crt_printf",
        "string_ops"
      ],
      "symbols": [
        {
          "symbol": "snprintf",
          "library": "legacy_stdio_definitions",
          "category": "crt_printf"
        },
        {
          "symbol": "CharUpperW",
          "library": "user32",
          "category": "string_ops"
        }
      ]
    }
  }
}
