          },
          {
            "name": "webview2",
            "mode": "Builtin"
          },
          {
            "name": "vulkan-1",
            "mode": "Builtin"
          },
          {
            "name": "opengl32",
            "mode": "Builtin"
          }
        ],
        "cpu_profile": null,
        "gfx_profile": {
          "feature_masks": [
            "metal",
            "d3d11_fl11_0",
            "d3d10_fl10_1",
            "d3d9_ex",
            "dxgi_1_6",
            "bc1237_compression",
            "msaa_8x",
            "hdr10"
          ],
          "shader_flags": [
            "dxil_to_msl",
            "async_pipeline_compile",
            "shader_cache"
          ]
        },
        "input_profile": null,
        "network_profile": {
          "policy": "allow_all",
          "whitelist": []
        },
        "fs_profile": {
          "case_mode": "insensitive",
          "long_paths_enabled": true
        }
      }
