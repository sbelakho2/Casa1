            "mode": "Builtin"
          },
          {
            "name": "dsound",
            "mode": "Builtin"
          },
          {
            "name": "winmm",
            "mode": "Builtin"
          },
          {
            "name": "mfplat",
            "mode": "Builtin"
          },
          {
