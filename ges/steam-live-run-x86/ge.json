{
  "schema_version": 2,
  "name": "steam-live-run-x86",
  "arch": "x86",
  "winver": "win11-23h2",
  "user_name": "casa1",
  "long_paths_enabled": false,
  "drive_mappings": [
    {
      "drive": "C",
      "target": "<GE>/drive_c",
      "read_only": false,
      "enabled": true,
      "requires_permission": false
    },
    {
      "drive": "Z",
      "target": "/",
      "read_only": true,
      "enabled": false,
      "requires_permission": true
    }
  ],
  "override_profiles": [
    {
      "id": "steam-optimal",
      "match_rule": {
        "install_path_wildcard": {
          "pattern": "**/Steam.exe"
        }
      },
      "payload": {
        "env_add": {
          "CASA1_AUDIO_DEVICE": "default",
          "CASA1_CEF_BRIDGE": "1",
          "CASA1_CEF_IOSURFACE": "1",
          "CASA1_D3D_FEATURE_LEVEL": "11_0",
          "CASA1_DSOUND_REAL": "1",
          "CASA1_DXGI_METAL_SWAPCHAIN": "1",
          "CASA1_GPU_COMPAT_VENDOR": "10de",
          "CASA1_HIDPI": "1",
          "CASA1_METAL_RENDERING": "1",
          "CASA1_OPENGL_METAL": "1",
          "CASA1_REAL_AUDIO": "1",
          "CASA1_STEAM_INPUT": "1",
          "CASA1_VULKAN_METAL": "1",
          "CASA1_WEBVIEW2": "1",
          "CASA1_XAUDIO2_REAL": "1"
        },
        "env_remove": [],
        "reg_set": [],
        "reg_delete": [],
        "dll_override": [
          {
            "name": "d3d11",
            "mode": "Builtin"
          },
          {
            "name": "d3d10",
            "mode": "Builtin"
          },
          {
            "name": "d3d9",
            "mode": "Builtin"
          },
